---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.jsx";
---

<Layout
  title="Software y Sistema de Reservas para Barberías y Spas | SystemLab"
>
  <Navbar client:load />

  <main>
    <!-- ═══════════════════════════════════════════ -->
    <!-- HERO                                        -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="hero-carousel" id="inicio">
      <!-- Slides -->
      <div class="hero-carousel__track" id="heroTrack">
        <div
          class="hero-carousel__slide active"
          style="background-image: url('/img/hero-slide-1.avif')"
        >
          <div class="hero-carousel__overlay"></div>
        </div>
        <div
          class="hero-carousel__slide"
          style="background-image: url('/img/hero-slide-2.avif')"
        >
          <div class="hero-carousel__overlay"></div>
        </div>
        <div
          class="hero-carousel__slide"
          style="background-image: url('/img/hero-slide-3.avif')"
        >
          <div class="hero-carousel__overlay"></div>
        </div>
      </div>

      <!-- Content overlay -->
      <div class="hero-carousel__content">
        <div class="container">
          <h1 class="hero-carousel__title">
            Tu Barbería no necesita otro "software genérico".<br />
            <span class="text-accent">Necesita multiplicar sus ganancias.</span>
          </h1>
          <p class="hero-carousel__subtitle">
            Somos la única agencia tecnológica enfocada exclusivamente en el
            rubro de Barberías y Spas. Desarrollamos sistemas de reservas y
            gestión que acaban con el desorden, llenan tu agenda en automático y
            te liberan de estar pegado al WhatsApp.
          </p>
          <div class="hero-carousel__actions">
            <a href="#contacto" class="btn btn--primary btn--large">
              Descubrir Cuánto Estás Perdiendo
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>
            <a href="#servicios" class="btn btn--outline btn--large"
              >Ver cómo operamos</a
            >
          </div>
        </div>
      </div>

      <!-- Navigation dots -->
      <div class="hero-carousel__dots" id="heroDots">
        <button
          class="hero-carousel__dot active"
          data-slide="0"
          aria-label="Slide 1"></button>
        <button class="hero-carousel__dot" data-slide="1" aria-label="Slide 2"
        ></button>
        <button class="hero-carousel__dot" data-slide="2" aria-label="Slide 3"
        ></button>
      </div>

      <!-- Progress bar -->
      <div class="hero-carousel__progress">
        <div class="hero-carousel__progress-bar" id="heroProgress"></div>
      </div>
    </section>

    <!-- Overlapping Project Cards -->
    <section class="hero-overlap-section">
      <div class="container">
        <div class="hero-projects-grid">
          <div
            class="hero-project-card"
            data-reveal="fade-up"
            data-reveal-delay="0"
          >
            <div
              class="hero-project-card__img"
              style="background-image: url('img/projects/floreria.avif')"
            >
            </div>
            <div class="hero-project-card__content">
              <h3>Florería: Canal de Ventas Automatizado</h3>
              <p>
                Catálogo digital donde el cliente compra y paga sin fricciones,
                mientras tú controlas tu inventario sin depender de
                intermediarios.
              </p>
              <a
                href="https://floreria-tiendaonline.infinityfreeapp.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--primary btn--small">Ver Proyecto</a
              >
            </div>
          </div>
          <div
            class="hero-project-card"
            data-reveal="fade-up"
            data-reveal-delay="100"
          >
            <div
              class="hero-project-card__img"
              style="background-image: url('img/projects/barberia.avif')"
            >
            </div>
            <div class="hero-project-card__content">
              <h3>Barbería: Gestor Automático de Citas</h3>
              <p>
                Agenda digital que organiza tus reservas, evita cruces de
                horarios y libera a tu equipo para que se enfoque en atender, no
                en contestar el teléfono.
              </p>
              <a
                href="https://sistema-reservas-barberia.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--primary btn--small">Ver Proyecto</a
              >
            </div>
          </div>
          <div
            class="hero-project-card dynamic-theme-card"
            data-reveal="fade-up"
            data-reveal-delay="200"
          >
            <div class="hero-project-card__visual">
              <div
                class="hero-project-card__img theme-light-img"
                style="background-image: url('/img/projects/portal-light.avif'); background-size: cover; background-position: top center;"
              >
              </div>
              <div
                class="hero-project-card__img theme-dark-img"
                style="background-image: url('/img/projects/portal-dark.avif'); background-size: cover; background-position: top center;"
              >
              </div>
              <button
                type="button"
                class="theme-switch-btn"
                aria-label="Cambiar tema de la tarjeta"
                onclick="this.closest('.dynamic-theme-card').classList.toggle('is-dark')"
              >
                <svg
                  class="sun-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><circle cx="12" cy="12" r="5"></circle><line
                    x1="12"
                    y1="1"
                    x2="12"
                    y2="3"></line><line x1="12" y1="21" x2="12" y2="23"
                  ></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
                  ></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
                  ></line><line x1="1" y1="12" x2="3" y2="12"></line><line
                    x1="21"
                    y1="12"
                    x2="23"
                    y2="12"></line><line
                    x1="4.22"
                    y1="19.78"
                    x2="5.64"
                    y2="18.36"></line><line
                    x1="18.36"
                    y1="5.64"
                    x2="19.78"
                    y2="4.22"></line></svg
                >
                <svg
                  class="moon-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                  ></path></svg
                >
              </button>
            </div>
            <div class="hero-project-card__content">
              <h3>Portal de Auto-Reserva: Agenda Digital Inteligente</h3>
              <p>
                Sistema de reservas automatizado con diseño premium (Clean UI).
                Permite a los clientes agendar citas 24/7 mientras tú gestionas
                la disponibilidad sin fricciones.
              </p>
              <a
                href="https://portal-de-auto-reserva.infinityfreeapp.com/"
                class="btn btn--primary btn--small">Ver Proyecto</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diagonal section divider -->
    <div class="section-divider section-divider--hero"></div>
    <!-- ═══════════════════════════════════════════ -->
    <!-- TRUST BAR (Confianza)                       -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="trust-bar">
      <div class="container">
        <div class="trust-bar__grid">
          <div
            class="trust-bar__item"
            data-reveal="fade-up"
            data-reveal-delay="0"
          >
            <div class="trust-bar__icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><line
                  x1="12"
                  y1="8"
                  x2="12"
                  y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"
                ></line></svg
              >
            </div>
            <div class="trust-bar__text">
              <strong>Agendas Llenas</strong>
              <span
                >Eliminamos los espacios vacíos y reducimos al mínimo los
                clientes que no asisten.</span
              >
            </div>
          </div>
          <div
            class="trust-bar__item"
            data-reveal="fade-up"
            data-reveal-delay="100"
          >
            <div class="trust-bar__icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path><polyline points="14 2 14 8 20 8"></polyline><line
                  x1="16"
                  y1="13"
                  x2="8"
                  y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
                ></line><polyline points="10 9 9 9 8 9"></polyline></svg
              >
            </div>
            <div class="trust-bar__text">
              <strong>Cero Comisiones</strong>
              <span
                >A diferencia de otras apps, nuestro sistema es tuyo. No te
                cobramos por cada reserva que entra.</span
              >
            </div>
          </div>
          <div
            class="trust-bar__item"
            data-reveal="fade-up"
            data-reveal-delay="200"
          >
            <div class="trust-bar__icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
            </div>
            <div class="trust-bar__text">
              <strong>Especialistas en tu Rubro</strong>
              <span
                >Conocemos el día a día de una barbería y un spa. Sabemos
                exactamente dónde pierdes dinero.</span
              >
            </div>
          </div>
          <div
            class="trust-bar__item"
            data-reveal="fade-up"
            data-reveal-delay="300"
          >
            <div class="trust-bar__icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
              >
            </div>
            <div class="trust-bar__text">
              <strong>Fácil de Usar</strong>
              <span
                >Diseñado para que cualquier miembro de tu equipo lo entienda en
                5 minutos. Sin complicaciones.</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- SERVICIOS                                   -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="services" id="servicios">
      <div class="services__bg-pattern"></div>
      <div class="container">
        <div class="section-header" data-reveal="fade-up">
          <h2 class="section-header__title">
            Olvida el desorden.<br /><span class="text-accent"
              >Construimos máquinas de venta:</span
            >
          </h2>
          <p class="section-header__desc">
            No te vendemos una página web estática. Te entregamos un sistema
            comercial completo para que ganes más trabajando menos.
          </p>
        </div>

        <div class="services__grid">
          <!-- Servicio 1 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="0"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  x="4"
                  y="8"
                  width="40"
                  height="28"
                  rx="3"
                  stroke="currentColor"
                  stroke-width="2.5"></rect>
                <line
                  x1="4"
                  y1="36"
                  x2="20"
                  y2="42"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></line>
                <line
                  x1="44"
                  y1="36"
                  x2="28"
                  y2="42"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></line>
                <line
                  x1="20"
                  y1="42"
                  x2="28"
                  y2="42"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></line>
                <polyline
                  points="16,22 20,26 28,18"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></polyline>
              </svg>
            </div>
            <h3 class="card__title">Agendamiento Automático 24/7</h3>
            <p class="card__desc">
              Tus clientes podrán reservar su corte o masaje a las 3 de la
              mañana desde su celular. El sistema verifica disponibilidad y
              aparta el cupo sin que tú intervengas.
            </p>
          </div>

          <!-- Servicio 2 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="100"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M14 16H34L38 28H10L14 16Z"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linejoin="round"></path>
                <path
                  d="M18 36C19.1046 36 20 35.1046 20 34C20 32.8954 19.1046 32 18 32C16.8954 32 16 32.8954 16 34C16 35.1046 16.8954 36 18 36Z"
                  fill="currentColor"></path>
                <path
                  d="M30 36C31.1046 36 32 35.1046 32 34C32 32.8954 31.1046 32 30 32C28.8954 32 28 32.8954 28 34C28 35.1046 28.8954 36 30 36Z"
                  fill="currentColor"></path>
                <path
                  d="M10 28V32C10 33.1046 10.8954 34 12 34H36C37.1046 34 38 33.1046 38 32V28"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M20 16V12C20 9.79086 21.7909 8 24 8C26.2091 8 28 9.79086 28 12V16"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <h3 class="card__title">Recordatorios Anti-Faltas</h3>
            <p class="card__desc">
              ¿Harto de los clientes que agendan y no llegan? Nuestro sistema
              envía alertas automáticas para que confirmen o cancelen a tiempo,
              permitiéndote ceder el espacio a otro cliente.
            </p>
          </div>

          <!-- Servicio 3 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="200"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  x="6"
                  y="10"
                  width="36"
                  height="28"
                  rx="3"
                  stroke="currentColor"
                  stroke-width="2.5"></rect>
                <line
                  x1="6"
                  y1="18"
                  x2="42"
                  y2="18"
                  stroke="currentColor"
                  stroke-width="2.5"></line>
                <line
                  x1="18"
                  y1="18"
                  x2="18"
                  y2="38"
                  stroke="currentColor"
                  stroke-width="2.5"></line>
                <circle cx="12" cy="14" r="1.5" fill="currentColor"></circle>
                <rect
                  x="22"
                  y="23"
                  width="14"
                  height="3"
                  rx="1"
                  fill="currentColor"
                  opacity="0.5"></rect>
                <rect
                  x="22"
                  y="29"
                  width="10"
                  height="3"
                  rx="1"
                  fill="currentColor"
                  opacity="0.5"></rect>
              </svg>
            </div>
            <h3 class="card__title">Automatización de Tareas Repetitivas</h3>
            <p class="card__desc">
              Tus empleados pierden 4 horas al día haciendo trabajo manual de
              "copiar y pegar". Escribimos los flujos invisibles que hacen ese
              trabajo por ellos para que se enfoquen en vender y operar.
            </p>
          </div>

          <!-- Servicio 4 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="0"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="16"
                  cy="16"
                  r="8"
                  stroke="currentColor"
                  stroke-width="2.5"></circle>
                <circle
                  cx="34"
                  cy="16"
                  r="8"
                  stroke="currentColor"
                  stroke-width="2.5"></circle>
                <circle
                  cx="24"
                  cy="34"
                  r="8"
                  stroke="currentColor"
                  stroke-width="2.5"></circle>
                <line
                  x1="20"
                  y1="22"
                  x2="22"
                  y2="28"
                  stroke="currentColor"
                  stroke-width="2.5"></line>
                <line
                  x1="28"
                  y1="22"
                  x2="26"
                  y2="28"
                  stroke="currentColor"
                  stroke-width="2.5"></line>
              </svg>
            </div>
            <h3 class="card__title">Sistema de Fidelización</h3>
            <p class="card__desc">
              Haz que tus clientes regresen una y otra vez. Implementamos
              programas de puntos y membresías VIP para que la competencia jamás
              pueda robarte a tu clientela frecuente.
            </p>
          </div>

          <!-- Servicio 5 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="100"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="24"
                  cy="24"
                  r="10"
                  stroke="currentColor"
                  stroke-width="2.5"></circle>
                <path
                  d="M24 4L24 10"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M24 38L24 44"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M4 24L10 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M38 24L44 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M20 24L22.5 26.5L28 21"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <h3 class="card__title">Páginas Web que Sí Venden</h3>
            <p class="card__desc">
              Creamos sitios web diseñados exclusivamente para convencer.
              Mostramos tu local, tus trabajos y testimonios de tal forma que el
              cliente sienta que eres su mejor opción.
            </p>
          </div>

          <!-- Servicio 6 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="200"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M24 8C14 8 8 14 8 24C8 34 14 40 24 40"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M24 8C34 8 40 14 40 24C40 34 34 40 24 40"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-dasharray="4 3"></path>
                <path
                  d="M28 20L36 12"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M36 12L36 18"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M36 12L30 12"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <circle cx="24" cy="24" r="4" fill="currentColor"></circle>
              </svg>
            </div>
            <h3 class="card__title">Pago Seguro y Adelantado</h3>
            <p class="card__desc">
              Permite que tus clientes paguen el servicio (o un adelanto) al
              momento de reservar. Aseguras tu dinero y reduces radicalmente las
              inasistencias en fechas clave.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Diagonal divider -->
    <div class="section-divider section-divider--services"></div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- NOSOTROS                                    -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="about" id="nosotros">
      <div class="about__bg-accent"></div>
      <div class="container about__inner">
        <div class="about__visual" data-reveal="fade-right">
          <div class="about__image-wrap">
            <div
              class="about__float-card about__float-card--1"
              data-parallax="0.04"
            >
              <span class="about__float-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--c-primary)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                  <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"></path>
                </svg>
              </span>
              <span>Precisión de laboratorio</span>
            </div>
            <div
              class="about__float-card about__float-card--2"
              data-parallax="-0.03"
            >
              <span class="about__float-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--c-primary)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                  ></path>
                  <circle cx="12" cy="12" r="4"></circle>
                </svg>
              </span>
              <span>Innovación constante</span>
            </div>
            <div class="about__hex-visual">
