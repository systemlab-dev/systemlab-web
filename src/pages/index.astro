                <option value="web">Desarrollo Web a Medida</option>
                <option value="mobile">Aplicaciones Móviles</option>
                <option value="erp">Sistemas de Gestión (ERP/CRM)</option>
                <option value="api">APIs & Microservicios</option>
                <option value="consulting">Consultoría Tecnológica</option>
                <option value="support">Soporte & Mantenimiento</option>
              </select>
