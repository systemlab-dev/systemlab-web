---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
---

<Layout title="SystemLab — Software único, negocios únicos">
  <Navbar client:load />
  
  <main>
    <!-- ═══════════════════════════════════════════ -->
    <!-- HERO                                        -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="hero hero--flat" id="inicio">
      <div class="container hero__inner">
        <div class="hero__content" data-reveal="fade-right">
          <span class="hero__badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            Disponibles para nuevos proyectos
          </span>
          <h1 class="hero__title">
            Software único,<br>
            <span class="text-accent">negocios únicos</span>
          </h1>
          <p class="hero__subtitle">Desarrollamos soluciones tecnológicas con arquitectura sólida y un enfoque Flat
            Design 2.0. Sin distracciones, rendimiento puro.</p>

          <div class="hero__actions">
            <a href="#contacto" class="btn btn--primary">
              Iniciar Proyecto
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
            <a href="#servicios" class="btn btn--outline">
              Ver Servicios
            </a>
          </div>
        </div>

        <div class="hero__visual" data-reveal="fade-left" data-reveal-delay="200">
          <div class="hero__logo-wrap">
            <div class="hero__orbit hero__orbit--1"></div>
            <div class="hero__orbit hero__orbit--2"></div>
            <svg class="hero__logo-main" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
              <path d="M40 60 L100 30 L160 60 L160 140 L100 170 L40 140 Z" fill="rgba(16, 185, 129, 0.1)"
                stroke="var(--c-primary)" stroke-width="2" />
              <path d="M55 70 L100 45 L145 70 L145 130 L100 155 L55 130 Z" fill="none" stroke="var(--c-primary)"
                stroke-width="1.5" />
              <path d="M70 85 L100 70 L130 85 L130 115 L100 130 L70 115 Z" fill="var(--c-primary)" />
              <text x="100" y="108" text-anchor="middle" fill="#fff" font-family="Inter, sans-serif" font-size="24"
                font-weight="800">SL</text>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- Overlapping Project Cards -->
    <section class="hero-overlap-section">
      <div class="container">
        <div class="hero-projects-grid">
          <div class="hero-project-card" data-reveal="fade-up" data-reveal-delay="0">
            <div class="hero-project-card__img" style="background-image: url('img/projects/floreria.avif')"></div>
            <div class="hero-project-card__content">
              <h3>Tienda Online Florería</h3>
              <p class="hero-project-card__tech"><strong>Stack:</strong> PHP, MySQL, MVC</p>
              <p>E-commerce autogestionable con panel de administración completo.</p>
              <a href="https://floreria-tiendaonline.infinityfreeapp.com/" target="_blank" rel="noopener noreferrer"
                class="btn btn--outline btn--small">Ver Proyecto</a>
            </div>
          </div>
          <div class="hero-project-card" data-reveal="fade-up" data-reveal-delay="100">
            <div class="hero-project-card__img" style="background-image: url('img/projects/barberia.avif')"></div>
            <div class="hero-project-card__content">
              <h3>Sistema Reservas Barbería</h3>
              <p class="hero-project-card__tech"><strong>Stack:</strong> Spring Boot, React, Docker</p>
              <p>Plataforma full-stack de reservas con gestión de citas en tiempo real.</p>
              <a href="https://sistema-reservas-barberia.vercel.app/" target="_blank" rel="noopener noreferrer"
                class="btn btn--outline btn--small">Ver Proyecto</a>
            </div>
          </div>
          <div class="hero-project-card" data-reveal="fade-up" data-reveal-delay="200">
            <div class="hero-project-card__img" style="background-image: url('img/projects/corporacion.avif')"></div>
            <div class="hero-project-card__content">
              <h3>Web Corporativa Raunass</h3>
              <p class="hero-project-card__tech"><strong>Stack:</strong> Astro, HTML/CSS, JS</p>
              <p>Portal institucional de alto rendimiento y SEO optimizado para empresa.</p>
              <a href="https://corporacionraunass.vercel.app/" target="_blank" rel="noopener noreferrer"
                class="btn btn--outline btn--small">Ver Proyecto</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diagonal section divider -->
    <div class="section-divider section-divider--hero"></div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- TRUST BAR (Confianza)                       -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="trust-bar">
      <div class="container">
        <div class="trust-bar__grid">
          <div class="trust-bar__item" data-reveal="fade-up" data-reveal-delay="0">
            <div class="trust-bar__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0110 0v4" />
              </svg>
            </div>
            <div class="trust-bar__text">
              <strong>Código Seguro</strong>
              <span>Mejores prácticas de seguridad</span>
            </div>
          </div>
          <div class="trust-bar__item" data-reveal="fade-up" data-reveal-delay="100">
            <div class="trust-bar__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
              </svg>
            </div>
            <div class="trust-bar__text">
              <strong>Alto Rendimiento</strong>
              <span>Optimización garantizada</span>
            </div>
          </div>
          <div class="trust-bar__item" data-reveal="fade-up" data-reveal-delay="200">
            <div class="trust-bar__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            <div class="trust-bar__text">
              <strong>Soporte Continuo</strong>
              <span>Acompañamiento post-entrega</span>
            </div>
          </div>
          <div class="trust-bar__item" data-reveal="fade-up" data-reveal-delay="300">
            <div class="trust-bar__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M15 22v-4a4.8 4.8 0 00-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 004 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </div>
            <div class="trust-bar__text">
              <strong>Gestión Profesional</strong>
              <span>GitHub & metodologías ágiles</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- SERVICIOS                                   -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="services theme-dark" id="servicios">
      <div class="services__bg-pattern"></div>
      <div class="container">
        <div class="section-header" data-reveal="fade-up">
          <span class="section-header__tag">Nuestros Servicios</span>
          <h2 class="section-header__title">Soluciones exactas para<br><span class="text-accent">desafíos reales</span>
          </h2>
          <p class="section-header__desc">Cada proyecto es único. Diseñamos y desarrollamos tecnología que se adapta
            perfectamente a las necesidades de tu negocio.</p>
        </div>

        <div class="services__grid">
          <!-- Servicio 1 -->
          <div class="card card--service" data-reveal="zoom-in" data-reveal-delay="0">
            <div class="card__icon-wrap">
              <svg class="card__icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="8" width="40" height="28" rx="3" stroke="currentColor" stroke-width="2.5" />
                <line x1="4" y1="36" x2="20" y2="42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <line x1="44" y1="36" x2="28" y2="42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <line x1="20" y1="42" x2="28" y2="42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <polyline points="16,22 20,26 28,18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                  stroke-linejoin="round" />
              </svg>
            </div>
            <h3 class="card__title">Desarrollo Web a Medida</h3>
            <p class="card__desc">Plataformas web modernas con interfaces limpias (Clean UI) y experiencia de usuario
              excepcional, construidas desde cero para tu negocio.</p>
            <div class="card__tags">
              <span class="tag">React</span>
              <span class="tag">Angular</span>
              <span class="tag">PHP</span>
              <span class="tag">Java</span>
            </div>
          </div>

          <!-- Servicio 2 -->
          <div class="card card--service" data-reveal="zoom-in" data-reveal-delay="100">
            <div class="card__icon-wrap">
              <svg class="card__icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14 16H34L38 28H10L14 16Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                <path d="M18 36C19.1046 36 20 35.1046 20 34C20 32.8954 19.1046 32 18 32C16.8954 32 16 32.8954 16 34C16 35.1046 16.8954 36 18 36Z" fill="currentColor"/>
                <path d="M30 36C31.1046 36 32 35.1046 32 34C32 32.8954 31.1046 32 30 32C28.8954 32 28 32.8954 28 34C28 35.1046 28.8954 36 30 36Z" fill="currentColor"/>
                <path d="M10 28V32C10 33.1046 10.8954 34 12 34H36C37.1046 34 38 33.1046 38 32V28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M20 16V12C20 9.79086 21.7909 8 24 8C26.2091 8 28 9.79086 28 12V16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="card__title">Tiendas Online & E-commerce</h3>
            <p class="card__desc">Plataformas de venta online seguras y escalables con pasarelas de pago integradas y paneles de administración fáciles de usar.</p>
            <div class="card__tags">
              <span class="tag">Ventas 24/7</span>
              <span class="tag">Pasarelas de Pago</span>
              <span class="tag">Autogestión</span>
            </div>
          </div>

          <!-- Servicio 3 -->
          <div class="card card--service" data-reveal="zoom-in" data-reveal-delay="200">
            <div class="card__icon-wrap">
              <svg class="card__icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="6" y="10" width="36" height="28" rx="3" stroke="currentColor" stroke-width="2.5" />
                <line x1="6" y1="18" x2="42" y2="18" stroke="currentColor" stroke-width="2.5" />
                <line x1="18" y1="18" x2="18" y2="38" stroke="currentColor" stroke-width="2.5" />
                <circle cx="12" cy="14" r="1.5" fill="currentColor" />
                <rect x="22" y="23" width="14" height="3" rx="1" fill="currentColor" opacity="0.5" />
                <rect x="22" y="29" width="10" height="3" rx="1" fill="currentColor" opacity="0.5" />
              </svg>
            </div>
            <h3 class="card__title">Sistemas de Gestión</h3>
            <p class="card__desc">ERP, CRM y sistemas administrativos personalizados que automatizan procesos y elevan
              la eficiencia operativa de tu empresa.</p>
            <div class="card__tags">
              <span class="tag">ERP</span>
              <span class="tag">CRM</span>
              <span class="tag">Dashboard</span>
            </div>
          </div>

          <!-- Servicio 4 -->
          <div class="card card--service" data-reveal="zoom-in" data-reveal-delay="0">
            <div class="card__icon-wrap">
              <svg class="card__icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="16" cy="16" r="8" stroke="currentColor" stroke-width="2.5" />
                <circle cx="34" cy="16" r="8" stroke="currentColor" stroke-width="2.5" />
                <circle cx="24" cy="34" r="8" stroke="currentColor" stroke-width="2.5" />
                <line x1="20" y1="22" x2="22" y2="28" stroke="currentColor" stroke-width="2.5" />
                <line x1="28" y1="22" x2="26" y2="28" stroke="currentColor" stroke-width="2.5" />
              </svg>
            </div>
            <h3 class="card__title">Integración de Sistemas</h3>
            <p class="card__desc">Conectamos tus herramientas y plataformas para que trabajen juntas, automatizando tareas, unificando datos y evitando el trabajo manual.</p>
            <div class="card__tags">
              <span class="tag">Automatización</span>
              <span class="tag">Conexiones</span>
              <span class="tag">Sincronización</span>
            </div>
          </div>

          <!-- Servicio 5 -->
          <div class="card card--service" data-reveal="zoom-in" data-reveal-delay="100">
            <div class="card__icon-wrap">
              <svg class="card__icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="10" stroke="currentColor" stroke-width="2.5" />
                <path d="M24 4L24 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <path d="M24 38L24 44" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <path d="M4 24L10 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <path d="M38 24L44 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <path d="M20 24L22.5 26.5L28 21" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                  stroke-linejoin="round" />
              </svg>
            </div>
            <h3 class="card__title">Consultoría Tecnológica</h3>
            <p class="card__desc">Analizamos tu negocio y te guiamos en la toma de decisiones tecnológicas correctas.
              Estrategia antes de código.</p>
            <div class="card__tags">
              <span class="tag">Análisis</span>
              <span class="tag">Estrategia</span>
              <span class="tag">Roadmap</span>
            </div>
          </div>

          <!-- Servicio 6 -->
          <div class="card card--service" data-reveal="zoom-in" data-reveal-delay="200">
            <div class="card__icon-wrap">
              <svg class="card__icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 8C14 8 8 14 8 24C8 34 14 40 24 40" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" />
                <path d="M24 8C34 8 40 14 40 24C40 34 34 40 24 40" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-dasharray="4 3" />
                <path d="M28 20L36 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <path d="M36 12L36 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <path d="M36 12L30 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="24" cy="24" r="4" fill="currentColor" />
              </svg>
            </div>
            <h3 class="card__title">Soporte & Mantenimiento</h3>
            <p class="card__desc">Acompañamiento post-entrega con monitoreo, actualizaciones y soporte técnico para que
              tu sistema siempre funcione al máximo.</p>
            <div class="card__tags">
              <span class="tag">24/7</span>
              <span class="tag">Monitoreo</span>
              <span class="tag">Updates</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diagonal divider -->
    <div class="section-divider section-divider--services"></div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- NOSOTROS                                    -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="about" id="nosotros">
      <div class="about__bg-accent"></div>
      <div class="container about__inner">
        <div class="about__visual" data-reveal="fade-right">
          <div class="about__image-wrap">
            <div class="about__float-card about__float-card--1" data-parallax="0.04">
              <span class="about__float-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--c-primary)" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="8" x2="12" y2="12" />
                  <line x1="12" y1="16" x2="12.01" y2="16" />
                  <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3" />
                </svg>
              </span>
              <span>Precisión de laboratorio</span>
            </div>
            <div class="about__float-card about__float-card--2" data-parallax="-0.03">
              <span class="about__float-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--c-primary)" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path
                    d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
                  <circle cx="12" cy="12" r="4" />
                </svg>
              </span>
              <span>Innovación constante</span>
            </div>
            <div class="about__hex-visual">
              <svg viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="hexGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#10b981;stop-opacity:0.15" />
                    <stop offset="100%" style="stop-color:#059669;stop-opacity:0.05" />
                  </linearGradient>
                </defs>
                <path d="M60 90 L150 45 L240 90 L240 210 L150 255 L60 210 Z" fill="url(#hexGrad)" stroke="#10b981"
                  stroke-width="2" opacity="0.6" />
                <path d="M90 110 L150 80 L210 110 L210 190 L150 220 L90 190 Z" fill="none" stroke="#10b981"
                  stroke-width="1.5" opacity="0.4" />
                <path d="M115 125 L150 108 L185 125 L185 175 L150 192 L115 175 Z" fill="#10b981" opacity="0.2" />
                <text x="150" y="155" text-anchor="middle" fill="#10b981" font-family="Inter, sans-serif" font-size="18"
                  font-weight="700" opacity="0.8">SL</text>
              </svg>
            </div>
          </div>
        </div>

        <div class="about__content" data-reveal="fade-left" data-reveal-delay="200">
          <span class="section-header__tag">Sobre Nosotros</span>
          <h2 class="section-header__title">El factor <span class="text-accent">"Lab"</span></h2>
          <p class="about__text">En <strong>SystemLab</strong>, funcionamos como un laboratorio de tecnología:
            experimentamos, analizamos y creamos soluciones con la misma precisión, cuidado e investigación que se tiene
            en un laboratorio científico.</p>
          <p class="about__text">No vendemos plantillas genéricas. Cada línea de código que escribimos está diseñada
            para resolver un problema específico de tu negocio. Utilizamos metodologías ágiles, gestión profesional con
            GitHub, y las mejores prácticas de la industria.</p>

          <div class="about__stats">
            <div class="about__stat" data-reveal="fade-up" data-reveal-delay="100">
              <span class="about__stat-number" data-count="50">0</span><span class="about__stat-suffix">+</span>
              <span class="about__stat-label">Proyectos Entregados</span>
            </div>
            <div class="about__stat" data-reveal="fade-up" data-reveal-delay="200">
              <span class="about__stat-number" data-count="30">0</span><span class="about__stat-suffix">+</span>
              <span class="about__stat-label">Clientes Satisfechos</span>
            </div>
            <div class="about__stat" data-reveal="fade-up" data-reveal-delay="300">
              <span class="about__stat-number" data-count="5">0</span><span class="about__stat-suffix">+</span>
              <span class="about__stat-label">Años de Experiencia</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diagonal divider -->
    <div class="section-divider section-divider--light-to-dark-1"></div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- POR QUÉ ELEGIRNOS (Confianza)              -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="why-us theme-dark">
      <div class="why-us__bg-pattern"></div>
      <div class="container">
        <div class="section-header" data-reveal="fade-up">
          <span class="section-header__tag">¿Por qué SystemLab?</span>
          <h2 class="section-header__title">Razones para <span class="text-accent">confiar</span> en nosotros</h2>
        </div>

        <div class="why-us__grid">
          <div class="card card--why" data-reveal="slide-right" data-reveal-delay="0">
            <div class="card__number">01</div>
            <h3 class="card__title">100% Personalizado</h3>
            <p class="card__desc">Cada solución se construye desde cero, adaptada exactamente a tus necesidades. Nada de
              plantillas, nada genérico.</p>
          </div>
          <div class="card card--why" data-reveal="slide-right" data-reveal-delay="100">
            <div class="card__number">02</div>
            <h3 class="card__title">Transparencia Total</h3>
            <p class="card__desc">Acceso a tu repositorio en GitHub desde el día uno. Ves cada avance, cada línea de
              código, en tiempo real.</p>
          </div>
          <div class="card card--why" data-reveal="slide-left" data-reveal-delay="200">
            <div class="card__number">03</div>
            <h3 class="card__title">Metodología Ágil</h3>
            <p class="card__desc">Entregas incrementales con feedback constante. No esperas meses — ves resultados desde
              las primeras semanas.</p>
          </div>
          <div class="card card--why" data-reveal="slide-right" data-reveal-delay="0">
            <div class="card__number">04</div>
