---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.jsx";
---

<Layout title="SystemLab — Automatización de procesos empresariales en Perú">
  <Navbar client:load />

  <main>
    <!-- ═══════════════════════════════════════════ -->
    <!-- HERO                                        -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="hero hero--flat" id="inicio">
      <div class="container hero__inner">
        <div class="hero__content" data-reveal="fade-right">
          <h1 class="hero__title">
            Tu empresa no necesita un "software a medida".<br />
            <span class="text-accent">Necesita dejar de botar plata.</span>
          </h1>
          <p class="hero__subtitle">
            No somos una fábrica de sistemas genéricos que tardan meses. Somos cirujanos tecnológicos: entramos, detectamos tu fuga de dinero, construimos la herramienta específica para taparla y salimos en semanas. Fin.
          </p>

          <div class="hero__actions">
            <a href="#contacto" class="btn btn--primary">
              Agendar Auditoría de Diagnóstico
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>
            <a href="#servicios" class="btn btn--outline"> Ver cómo operamos </a>
          </div>
        </div>

        <div
          class="hero__visual"
          data-reveal="fade-left"
          data-reveal-delay="200"
        >
          <div class="hero__logo-wrap">
            <div class="hero__orbit hero__orbit--1"></div>
            <div class="hero__orbit hero__orbit--2"></div>
            <svg
              class="hero__logo-main"
              viewBox="0 0 200 200"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M40 60 L100 30 L160 60 L160 140 L100 170 L40 140 Z"
                fill="rgba(16, 185, 129, 0.1)"
                stroke="var(--c-primary)"
                stroke-width="2"></path>
              <path
                d="M55 70 L100 45 L145 70 L145 130 L100 155 L55 130 Z"
                fill="none"
                stroke="var(--c-primary)"
                stroke-width="1.5"></path>
              <path
                d="M70 85 L100 70 L130 85 L130 115 L100 130 L70 115 Z"
                fill="var(--c-primary)"></path>
              <text
                x="100"
                y="108"
                text-anchor="middle"
                fill="#fff"
                font-family="Inter, sans-serif"
                font-size="24"
                font-weight="800">SL</text
              >
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- Overlapping Project Cards -->
    <section class="hero-overlap-section">
      <div class="container">
        <div class="hero-projects-grid">
          <div
            class="hero-project-card"
            data-reveal="fade-up"
            data-reveal-delay="0"
          >
            <div
              class="hero-project-card__img"
              style="background-image: url('img/projects/floreria.avif')"
            >
            </div>
            <div class="hero-project-card__content">
              <h3>Florería: Canal de Ventas Automatizado</h3>
              <p>
                Catálogo digital donde el cliente compra y paga sin fricciones, mientras tú controlas tu inventario sin depender de intermediarios.
              </p>
              <a
                href="https://floreria-tiendaonline.infinityfreeapp.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--outline btn--small">Ver Proyecto</a>
            </div>
          </div>
          <div
            class="hero-project-card"
            data-reveal="fade-up"
            data-reveal-delay="100"
          >
            <div
              class="hero-project-card__img"
              style="background-image: url('img/projects/barberia.avif')"
            >
            </div>
            <div class="hero-project-card__content">
              <h3>Barbería: Gestor Automático de Citas</h3>
              <p>
                Agenda digital que organiza tus reservas, evita cruces de horarios y libera a tu equipo para que se enfoque en atender, no en contestar el teléfono.
              </p>
              <a
                href="https://sistema-reservas-barberia.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--outline btn--small">Ver Proyecto</a>
            </div>
          </div>
          <div
            class="hero-project-card"
            data-reveal="fade-up"
            data-reveal-delay="200"
          >
            <div
              class="hero-project-card__img"
              style="background-image: url('img/projects/corporacion.avif')"
            >
            </div>
            <div class="hero-project-card__content">
              <h3>Corporación Raunass: Sucursal Digital de Alto Rendimiento</h3>
              <p>
                Presencia en internet optimizada para que tus clientes corporativos te encuentren primero y confíen en ti al instante.
              </p>
              <a
                href="https://corporacionraunass.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--outline btn--small">Ver Proyecto</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diagonal section divider -->
    <div class="section-divider section-divider--hero"></div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- TRUST BAR (Confianza)                       -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="trust-bar">
      <div class="container">
        <div class="trust-bar__grid">
          <div class="trust-bar__item" data-reveal="fade-up" data-reveal-delay="0">
            <div class="trust-bar__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            </div>
            <div class="trust-bar__text">
              <strong>Enfoque en ROI</strong>
              <span>Si la herramienta no te ahorra tiempo o dinero medible, no la construimos.</span>
            </div>
          </div>
          <div class="trust-bar__item" data-reveal="fade-up" data-reveal-delay="100">
            <div class="trust-bar__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <div class="trust-bar__text">
              <strong>Transparencia Total</strong>
              <span>Cero cajas negras. Ves cada avance y cada línea de código desde el día uno.</span>
            </div>
          </div>
          <div class="trust-bar__item" data-reveal="fade-up" data-reveal-delay="200">
            <div class="trust-bar__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="trust-bar__text">
              <strong>Ejecución Rápida</strong>
              <span>Resultados en semanas, no en semestres. Velocidad quirúrgica para tu negocio.</span>
            </div>
          </div>
          <div class="trust-bar__item" data-reveal="fade-up" data-reveal-delay="300">
            <div class="trust-bar__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <div class="trust-bar__text">
              <strong>Propiedad del Código</strong>
              <span>Tú eres el dueño. Cero comisiones, cero licencias abusivas, cero dependencias.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- SERVICIOS                                   -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="services theme-dark" id="servicios">
      <div class="services__bg-pattern"></div>
      <div class="container">
        <div class="section-header" data-reveal="fade-up">
          <span class="section-header__tag">Nuestros Servicios</span>
          <h2 class="section-header__title">
            Olvida el "Desarrollo Web".<br /><span class="text-accent"
              >Hacemos esto:</span
            >
          </h2>
          <p class="section-header__desc">
            No vendemos líneas de código. Vendemos herramientas que taparán tus fugas de dinero y a tus empleados les dará gusto usar.
          </p>
        </div>

        <div class="services__grid">
          <!-- Servicio 1 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="0"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  x="4"
                  y="8"
                  width="40"
                  height="28"
                  rx="3"
                  stroke="currentColor"
                  stroke-width="2.5"></rect>
                <line
                  x1="4"
                  y1="36"
                  x2="20"
                  y2="42"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></line>
                <line
                  x1="44"
                  y1="36"
                  x2="28"
                  y2="42"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></line>
                <line
                  x1="20"
                  y1="42"
                  x2="28"
                  y2="42"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></line>
                <polyline
                  points="16,22 20,26 28,18"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></polyline>
              </svg>
            </div>
            <h3 class="card__title">Migración de Procesos a la Nube</h3>
            <p class="card__desc">
              Tienes a tu equipo atrapado cruzando datos en Excel. Eliminamos el error humano construyendo un panel privado y seguro donde tu información fluye automáticamente y nada se borra por accidente.
            </p>
            <div class="card__tags">
              <span class="tag">Sin Errores</span>
              <span class="tag">Privado</span>
              <span class="tag">Automático</span>
            </div>
          </div>

          <!-- Servicio 2 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="100"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M14 16H34L38 28H10L14 16Z"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linejoin="round"></path>
                <path
                  d="M18 36C19.1046 36 20 35.1046 20 34C20 32.8954 19.1046 32 18 32C16.8954 32 16 32.8954 16 34C16 35.1046 16.8954 36 18 36Z"
                  fill="currentColor"></path>
                <path
                  d="M30 36C31.1046 36 32 35.1046 32 34C32 32.8954 31.1046 32 30 32C28.8954 32 28 32.8954 28 34C28 35.1046 28.8954 36 30 36Z"
                  fill="currentColor"></path>
                <path
                  d="M10 28V32C10 33.1046 10.8954 34 12 34H36C37.1046 34 38 33.1046 38 32V28"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M20 16V12C20 9.79086 21.7909 8 24 8C26.2091 8 28 9.79086 28 12V16"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <h3 class="card__title">Canales de Venta Directa</h3>
            <p class="card__desc">
              Pierdes ventas por procesos de pago confusos o catálogos lentos. Diseñamos plataformas ultra-rápidas donde el cliente elige y compra sin fricción. Sin depender de terceros ni pagar comisiones por venta.
            </p>
            <div class="card__tags">
              <span class="tag">Rápido</span>
              <span class="tag">Cero Comisiones</span>
              <span class="tag">UX Fluido</span>
            </div>
          </div>

          <!-- Servicio 3 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="200"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  x="6"
                  y="10"
                  width="36"
                  height="28"
                  rx="3"
                  stroke="currentColor"
                  stroke-width="2.5"></rect>
                <line
                  x1="6"
                  y1="18"
                  x2="42"
                  y2="18"
                  stroke="currentColor"
                  stroke-width="2.5"></line>
                <line
                  x1="18"
                  y1="18"
                  x2="18"
                  y2="38"
                  stroke="currentColor"
                  stroke-width="2.5"></line>
                <circle cx="12" cy="14" r="1.5" fill="currentColor"></circle>
                <rect
                  x="22"
                  y="23"
                  width="14"
                  height="3"
                  rx="1"
                  fill="currentColor"
                  opacity="0.5"></rect>
                <rect
                  x="22"
                  y="29"
                  width="10"
                  height="3"
                  rx="1"
                  fill="currentColor"
                  opacity="0.5"></rect>
              </svg>
            </div>
            <h3 class="card__title">Automatización de Tareas Repetitivas</h3>
            <p class="card__desc">
              Tus empleados pierden 4 horas al día haciendo trabajo manual de "copiar y pegar". Escribimos los flujos invisibles que hacen ese trabajo por ellos para que se enfoquen en vender y operar.
            </p>
            <div class="card__tags">
              <span class="tag">Cero Manual</span>
              <span class="tag">Flujos</span>
              <span class="tag">Productividad</span>
            </div>
          </div>

          <!-- Servicio 4 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="0"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="16"
                  cy="16"
                  r="8"
                  stroke="currentColor"
                  stroke-width="2.5"></circle>
                <circle
                  cx="34"
                  cy="16"
                  r="8"
                  stroke="currentColor"
                  stroke-width="2.5"></circle>
                <circle
                  cx="24"
                  cy="34"
                  r="8"
                  stroke="currentColor"
                  stroke-width="2.5"></circle>
                <line
                  x1="20"
                  y1="22"
                  x2="22"
                  y2="28"
                  stroke="currentColor"
                  stroke-width="2.5"></line>
                <line
                  x1="28"
                  y1="22"
                  x2="26"
                  y2="28"
                  stroke="currentColor"
                  stroke-width="2.5"></line>
              </svg>
            </div>
            <h3 class="card__title">Conexión de Software Empresarial</h3>
            <p class="card__desc">
              Tienes 3 sistemas (CRM, Facturación, Inventario) que no se hablan entre sí. Construimos los puentes exactos para que la información fluya sola y mates la doble digitación de una vez por todas.
            </p>
            <div class="card__tags">
              <span class="tag">Integración</span>
              <span class="tag">APIs</span>
              <span class="tag">Cero Doble Digitación</span>
            </div>
          </div>

          <!-- Servicio 5 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="100"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="24"
                  cy="24"
                  r="10"
                  stroke="currentColor"
                  stroke-width="2.5"></circle>
                <path
                  d="M24 4L24 10"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M24 38L24 44"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M4 24L10 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M38 24L44 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M20 24L22.5 26.5L28 21"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <h3 class="card__title">Auditoría de Cuellos de Botella</h3>
            <p class="card__desc">
              Sabes que pierdes plata en tu operación, pero no sabes exactamente dónde. Analizamos a fondo los procesos técnicos de tu empresa y te entregamos un plan de acción directo para tapar la hemorragia.
            </p>
            <div class="card__tags">
              <span class="tag">Diagnóstico</span>
              <span class="tag">Estrategia</span>
              <span class="tag">Plan Acción</span>
            </div>
          </div>

          <!-- Servicio 6 -->
          <div
            class="card card--service"
            data-reveal="zoom-in"
            data-reveal-delay="200"
          >
            <div class="card__icon-wrap">
              <svg
                class="card__icon"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M24 8C14 8 8 14 8 24C8 34 14 40 24 40"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M24 8C34 8 40 14 40 24C40 34 34 40 24 40"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-dasharray="4 3"></path>
                <path
                  d="M28 20L36 12"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M36 12L36 18"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path
                  d="M36 12L30 12"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <circle cx="24" cy="24" r="4" fill="currentColor"></circle>
              </svg>
            </div>
            <h3 class="card__title">Continuidad Operativa</h3>
            <p class="card__desc">
              Un sistema caído es dinero perdido. Mantenemos tu infraestructura limpia, optimizada y vigilada las 24 horas. Prevenimos el desastre antes de que ocurra.
            </p>
            <div class="card__tags">
              <span class="tag">Monitoreo</span>
              <span class="tag">Uptime</span>
              <span class="tag">24/7</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diagonal divider -->
    <div class="section-divider section-divider--services"></div>

    <!-- ═══════════════════════════════════════════ -->
    <!-- NOSOTROS                                    -->
    <!-- ═══════════════════════════════════════════ -->
    <section class="about" id="nosotros">
      <div class="about__bg-accent"></div>
      <div class="container about__inner">
        <div class="about__visual" data-reveal="fade-right">
          <div class="about__image-wrap">
            <div
              class="about__float-card about__float-card--1"
              data-parallax="0.04"
            >
              <span class="about__float-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--c-primary)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                  <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"></path>
                </svg>
              </span>
              <span>Precisión de laboratorio</span>
            </div>
            <div
              class="about__float-card about__float-card--2"
              data-parallax="-0.03"
            >
              <span class="about__float-icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--c-primary)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                  ></path>
                  <circle cx="12" cy="12" r="4"></circle>
                </svg>
              </span>
              <span>Innovación constante</span>
            </div>
            <div class="about__hex-visual">
              <svg viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient
                    id="hexGrad"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="100%"
                  >
                    <stop
                      offset="0%"
                      style="stop-color:#10b981;stop-opacity:0.15"></stop>
                    <stop
                      offset="100%"
                      style="stop-color:#059669;stop-opacity:0.05"></stop>
                  </linearGradient>
                </defs>
                <path
                  d="M60 90 L150 45 L240 90 L240 210 L150 255 L60 210 Z"
                  fill="url(#hexGrad)"
                  stroke="#10b981"
                  stroke-width="2"
                  opacity="0.6"></path>
                <path
                  d="M90 110 L150 80 L210 110 L210 190 L150 220 L90 190 Z"
                  fill="none"
                  stroke="#10b981"
                  stroke-width="1.5"
                  opacity="0.4"></path>
                <path
                  d="M115 125 L150 108 L185 125 L185 175 L150 192 L115 175 Z"
                  fill="#10b981"
                  opacity="0.2"></path>
                <text
                  x="150"
                  y="155"
                  text-anchor="middle"
                  fill="#10b981"
                  font-family="Inter, sans-serif"
                  font-size="18"
                  font-weight="700"
                  opacity="0.8">SL</text
                >
              </svg>
            </div>
          </div>
        </div>

        <div
          class="about__content"
          data-reveal="fade-left"
          data-reveal-delay="200"
        >
          <span class="section-header__tag">Sobre Nosotros</span>
          <h2 class="section-header__title">
            No somos una fábrica de software.<br />
