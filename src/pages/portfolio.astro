---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import ProjectTimeline from '../components/ProjectTimeline.astro';
---

<Layout title="Portafolio — SystemLab">
  <Navbar client:load />

  <!-- Hero -->
  <section class="portfolio-hero">
    <div class="container">
      <h1 class="portfolio-hero__title" data-reveal="fade-up">Casos de <span class="text-accent">Éxito y Rentabilidad</span></h1>
      <p class="portfolio-hero__desc" data-reveal="fade-up" data-reveal-delay="100">
        No vendemos "webs bonitas". Vendemos herramientas que resuelven desastres operativos. Descubre cómo transformamos la pérdida en ganancia para nuestros clientes.
      </p>
    </div>
  </section>

  <!-- Proyectos con Línea de Tiempo Animada -->
  <ProjectTimeline />

  <!-- CTA -->
  <section class="portfolio-cta">
    <div class="container" data-reveal="zoom-in">
      <h2>¿Listo para digitalizar tu negocio?</h2>
      <p>Construyamos juntos el próximo caso de éxito. Código robusto, diseño impecable.</p>
      <a href="/#contacto" class="btn btn--primary btn--large" style="margin-top: 20px;">
        Iniciar Cotización
      </a>
    </div>
  </section>

  <!-- Footer Simple -->
  <footer class="footer" style="padding: 40px 0; border-top: 1px solid rgba(255,255,255,0.05);">
    <div class="container" style="text-align: center; color: #94a3b8;">
      <p>&copy; 2026 SystemLab. Todos los derechos reservados.</p>
    </div>
  </footer>

  <script is:inline src="/js/main.js"></script>
</Layout>

<style is:global>
/* Estilos súper personalizados para el Portafolio */
body {
  background-color: #0f172a;
}


.portfolio-hero {
  padding: 200px 0 120px;
  text-align: center;
  background: radial-gradient(circle at top, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
  position: relative;
  overflow: hidden;
}

.portfolio-hero::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=');
  z-index: 0;
}

.portfolio-hero .container {
  position: relative;
  z-index: 10;
}

.portfolio-hero__title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(3rem, 5vw, 5rem);
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: var(--space-md);
  color: #fff;
  letter-spacing: -1px;
}

.portfolio-hero__desc {
  font-size: var(--fs-lg);
  color: #94a3b8;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.6;
}

.portfolio-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 100px;
  padding: var(--space-2xl) 0 120px;
  position: relative;
}

.portfolio-item {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-xl);
  align-items: center;
  background: #1e293b;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
  overflow: hidden;
  position: relative;
}

@media (min-width: 992px) {
  /* La línea central conectora */
  .portfolio-grid::before {
    content: '';
    position: absolute;
    top: 100px;
    bottom: 100px;
    left: 50%;
    width: 2px;
    background: linear-gradient(to bottom, transparent, rgba(16, 185, 129, 0.5), transparent);
    transform: translateX(-50%);
    z-index: 0;
  }

  /* El punto brillante en el centro de cada proyecto */
  .portfolio-item::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    background: var(--c-primary);
    border: 4px solid #1e293b;
    border-radius: 50%;
    box-shadow: 0 0 15px var(--c-primary);
    z-index: 10;
    transition: transform 0.3s ease;
  }

  .portfolio-item:hover::after {
    transform: translate(-50%, -50%) scale(1.3);
  }

  .portfolio-item {
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: transparent;
    border: none;
    box-shadow: none !important;
    overflow: visible;
  }
  
  .portfolio-item:nth-child(even) {
    grid-template-columns: 1fr 1fr;
  }
  .portfolio-item:nth-child(even) .portfolio-item__content {
    order: -1;
  }

  .portfolio-item__img-wrap {
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .portfolio-item__content {
    padding: 0 40px;
  }
}

.portfolio-item:hover {
  transform: translateY(-10px);
  box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5);
  border-color: rgba(16, 185, 129, 0.3);
}

.portfolio-item__img-wrap {
  width: 100%;
  aspect-ratio: 16 / 9;
  position: relative;
  overflow: hidden;
  background: #0a0f1a;
}

.portfolio-item__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.7s ease;
}

.portfolio-item:hover .portfolio-item__img {
  transform: scale(1.05);
}

.portfolio-item__content {
  padding: 40px;
}

.portfolio-item__tag {
  display: inline-block;
  padding: 6px 14px;
  background: rgba(16, 185, 129, 0.1);
  color: var(--c-primary);
  border-radius: 100px;
  font-size: var(--fs-xs);
  font-weight: 700;
  margin-bottom: var(--space-md);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

.portfolio-item__title {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  color: #fff;
  margin-bottom: var(--space-sm);
  line-height: 1.2;
}

.portfolio-item__desc {
  font-size: var(--fs-base);
  color: #94a3b8;
  line-height: 1.8;
  margin-bottom: var(--space-xl);
}

.portfolio-item__tech {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: var(--space-2xl);
}

.portfolio-item__tech span {
  font-size: var(--fs-xs);
  color: #cbd5e1;
  background: #0f172a;
  padding: 8px 16px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-family: monospace;
  letter-spacing: 0.5px;
}

.portfolio-cta {
  padding: 120px 0;
  text-align: center;
  background: linear-gradient(0deg, rgba(16, 185, 129, 0.05) 0%, transparent 100%);
}

.portfolio-cta h2 {
  font-size: clamp(2rem, 4vw, 3.5rem);
  color: #fff;
  margin-bottom: var(--space-md);
  font-weight: 800;
}

.portfolio-cta p {
  color: #94a3b8;
  font-size: var(--fs-lg);
  margin-bottom: var(--space-xl);
}

@media (max-width: 768px) {
  .portfolio-item__content {
    padding: 30px;
  }
}
</style>
