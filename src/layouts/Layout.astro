---
import '../styles/global.css';
import  SpeedInsights  from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Software y Reservas para Barberías y Spas | SystemLab",
  description = "Aumenta tus ganancias con nuestro software exclusivo para barberías y spas. Sistema de reservas 24/7, recordatorios anti-faltas y páginas web que venden."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth theme-dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content="software para barberías, sistema de reservas spa, agendamiento automático, desarrollo web barbería, software gestión spa, SystemLab Perú">
  <meta name="author" content="SystemLab">
  <title>{title}</title>

  <!-- Open Graph & SEO (Para que salga 'SystemLab' en Google y redes sociales) -->
  <meta property="og:site_name" content="SystemLab">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://systemlab.com.pe/">
  <meta property="og:image" content="https://systemlab.com.pe/img/Logo/screen.png">

  <!-- Structured Data para Google Search Console (Define el Site Name oficial y Software) -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://systemlab.com.pe/#website",
          "url": "https://systemlab.com.pe/",
          "name": "SystemLab",
          "description": "Software y Reservas para Barberías y Spas",
          "publisher": {
            "@id": "https://systemlab.com.pe/#organization"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://systemlab.com.pe/#organization",
          "name": "SystemLab",
          "url": "https://systemlab.com.pe/",
          "logo": "https://systemlab.com.pe/img/Logo/screen.png",
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+51-970-125-912",
            "contactType": "customer service",
            "areaServed": "PE",
            "availableLanguage": "es"
          }
        },
        {
          "@type": "SoftwareApplication",
          "name": "SystemLab Barber & Spa",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, iOS, Android",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "PEN"
          }
        }
      ]
    }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@700;800;900&display=swap" rel="stylesheet">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any">
  <link rel="apple-touch-icon" href="/favicon.svg">
</head>
<body>
  <slot />
  <SpeedInsights />
</body>
</html>
